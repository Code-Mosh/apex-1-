{%- style -%}
  .hero-{{ section.id }} {
    padding: 4rem 0;
    background: linear-gradient(135deg, {{ section.settings.bg_color_1 }} 0%, {{ section.settings.bg_color_2 }} 100%);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-container-{{ section.id }} {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
    position: relative;
    z-index: 2;
  }

  .hero-badge-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(135deg, rgba(255, 107, 53, 0.1) 0%, rgba(233, 30, 99, 0.1) 100%);
    color: #c2410c;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .hero-title-{{ section.id }} {
    font-size: 3rem;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  @media (min-width: 768px) {
    .hero-title-{{ section.id }} {
      font-size: 4rem;
    }
  }

  .hero-subtitle-{{ section.id }} {
    font-size: 1.5rem;
    font-weight: 700;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
  }

  .hero-description-{{ section.id }} {
    font-size: 1.25rem;
    color: {{ section.settings.description_color }};
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-buttons-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .hero-buttons-{{ section.id }} {
      flex-direction: row;
      justify-content: center;
    }
  }

  .hero-stats-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .hero-stat-{{ section.id }} {
    text-align: center;
  }

  .hero-stat-number-{{ section.id }} {
    font-size: 1.875rem;
    font-weight: 700;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-stat-label-{{ section.id }} {
    color: #6b7280;
    font-weight: 500;
  }

  /* Background decoration */
  .hero-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 20%;
    left: -10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255, 107, 53, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    animation: float 6s ease-in-out infinite;
  }

  .hero-{{ section.id }}::after {
    content: '';
    position: absolute;
    bottom: 20%;
    right: -10%;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(233, 30, 99, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    animation: float 6s ease-in-out infinite reverse;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(180deg); }
  }
{%- endstyle -%}

<section id="home" class="hero-{{ section.id }}">
  <div class="hero-container-{{ section.id }}">
    {%- if section.settings.badge_text != blank -%}
      <div class="hero-badge-{{ section.id }}">
        {{ section.settings.badge_icon }} {{ section.settings.badge_text }}
      </div>
    {%- endif -%}
    
    {%- if section.settings.title != blank -%}
      <h1 class="hero-title-{{ section.id }}">{{ section.settings.title }}</h1>
    {%- endif -%}
    
    {%- if section.settings.subtitle != blank -%}
      <h2 class="hero-subtitle-{{ section.id }}">{{ section.settings.subtitle }}</h2>
    {%- endif -%}
    
    {%- if section.settings.description != blank -%}
      <p class="hero-description-{{ section.id }}">{{ section.settings.description }}</p>
    {%- endif -%}
    
    <div class="hero-buttons-{{ section.id }}">
      {%- if section.settings.button_primary_text != blank -%}
        <a href="{{ section.settings.button_primary_link }}" class="btn-primary">
          {{ section.settings.button_primary_text }}
          {%- if section.settings.button_primary_icon -%}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {%- endif -%}
        </a>
      {%- endif -%}
      
      {%- if section.settings.button_secondary_text != blank -%}
        <a href="{{ section.settings.button_secondary_link }}" class="btn-secondary">
          {{ section.settings.button_secondary_text }}
        </a>
      {%- endif -%}
    </div>
    
    {%- if section.blocks.size > 0 -%}
      <div class="hero-stats-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'stat' -%}
              <div class="hero-stat-{{ section.id }}" {{ block.shopify_attributes }}>
                <div class="hero-stat-number-{{ section.id }}">{{ block.settings.number }}</div>
                <div class="hero-stat-label-{{ section.id }}">{{ block.settings.label }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "default": "Trusted by 500+ Businesses",
      "label": "Badge text"
    },
    {
      "type": "text",
      "id": "badge_icon",
      "default": "⭐",
      "label": "Badge icon"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Professional Web Design",
      "label": "Main title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "default": "SERVICES & TEMPLATES",
      "label": "Subtitle"
    },
    {
      "type": "textarea",
      "id": "description",
      "default": "From custom websites to premium templates - we deliver stunning, conversion-focused web solutions that drive results for your business.",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_primary_text",
      "default": "GET FREE QUOTE",
      "label": "Primary button text"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "default": "#contact",
      "label": "Primary button link"
    },
    {
      "type": "checkbox",
      "id": "button_primary_icon",
      "default": true,
      "label": "Show primary button icon"
    },
    {
      "type": "text",
      "id": "button_secondary_text",
      "default": "View Services",
      "label": "Secondary button text"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "default": "#services",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color_1",
      "default": "#f9fafb",
      "label": "Background color 1"
    },
    {
      "type": "color",
      "id": "bg_color_2",
      "default": "#ffffff",
      "label": "Background color 2"
    },
    {
      "type": "color",
      "id": "title_color",
      "default": "#111827",
      "label": "Title color"
    },
    {
      "type": "color",
      "id": "description_color",
      "default": "#6b7280",
      "label": "Description color"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "default": "500+",
          "label": "Number"
        },
        {
          "type": "text",
          "id": "label",
          "default": "Projects Completed",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "500+",
            "label": "Projects Completed"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "98%",
            "label": "Client Satisfaction"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "24/7",
            "label": "Support Available"
          }
        }
      ]
    }
  ]
}
{% endschema %}