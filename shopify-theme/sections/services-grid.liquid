{%- style -%}
  .services-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  .services-container-{{ section.id }} {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
    text-align: center;
  }

  .services-header-{{ section.id }} {
    margin-bottom: 4rem;
  }

  .services-title-{{ section.id }} {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin-bottom: 1rem;
  }

  .services-highlight-{{ section.id }} {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .services-description-{{ section.id }} {
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
    margin-bottom: 3rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .services-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .services-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  .service-card-{{ section.id }} {
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: 2rem;
    box-shadow: {{ section.settings.card_shadow }};
    border: 2px solid transparent;
    transition: all 0.3s ease;
    text-align: left;
  }

  .service-card-{{ section.id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    border-color: rgba(255, 107, 53, 0.2);
  }

  .service-header-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .service-icon-{{ section.id }} {
    padding: 0.75rem;
    background: linear-gradient(135deg, rgba(255, 107, 53, 0.1) 0%, rgba(233, 30, 99, 0.1) 100%);
    border-radius: 0.75rem;
    transition: all 0.3s ease;
  }

  .service-card-{{ section.id }}:hover .service-icon-{{ section.id }} {
    background: linear-gradient(135deg, rgba(255, 107, 53, 0.2) 0%, rgba(233, 30, 99, 0.2) 100%);
  }

  .service-title-{{ section.id }} {
    font-size: 1.5rem;
    font-weight: 700;
    color: {{ section.settings.card_title_color }};
    transition: color 0.3s ease;
  }

  .service-card-{{ section.id }}:hover .service-title-{{ section.id }} {
    color: #ea580c;
  }

  .service-description-{{ section.id }} {
    color: {{ section.settings.card_text_color }};
    margin-bottom: 1.5rem;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .service-features-{{ section.id }} {
    margin-bottom: 1.5rem;
  }

  .service-feature-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .service-feature-icon-{{ section.id }} {
    width: 20px;
    height: 20px;
    color: #22c55e;
    flex-shrink: 0;
  }

  .service-button-{{ section.id }} {
    width: 100%;
    text-align: center;
  }

  .services-cta-{{ section.id }} {
    background: linear-gradient(135deg, {{ section.settings.cta_bg_color_1 }} 0%, {{ section.settings.cta_bg_color_2 }} 100%);
    border-radius: 1.5rem;
    padding: 3rem;
    text-align: center;
    margin-top: 4rem;
  }

  .services-cta-title-{{ section.id }} {
    font-size: 1.875rem;
    font-weight: 700;
    color: {{ section.settings.cta_title_color }};
    margin-bottom: 1rem;
  }

  .services-cta-description-{{ section.id }} {
    color: {{ section.settings.cta_text_color }};
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }
{%- endstyle -%}

<section id="services" class="services-{{ section.id }}">
  <div class="services-container-{{ section.id }}">
    <div class="services-header-{{ section.id }}">
      {%- if section.settings.title != blank -%}
        <h2 class="services-title-{{ section.id }}">
          {{ section.settings.title_prefix }}
          {%- if section.settings.title_highlight != blank -%}
            <span class="services-highlight-{{ section.id }}">{{ section.settings.title_highlight }}</span>
          {%- endif -%}
          {{ section.settings.title_suffix }}
        </h2>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <p class="services-description-{{ section.id }}">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>
    
    {%- if section.blocks.size > 0 -%}
      <div class="services-grid-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'service' -%}
              <div class="service-card-{{ section.id }}" {{ block.shopify_attributes }}>
                <div class="service-header-{{ section.id }}">
                  {%- if block.settings.icon != blank -%}
                    <div class="service-icon-{{ section.id }}">
                      {{ block.settings.icon }}
                    </div>
                  {%- endif -%}
                  <h3 class="service-title-{{ section.id }}">{{ block.settings.title }}</h3>
                </div>
                
                {%- if block.settings.description != blank -%}
                  <p class="service-description-{{ section.id }}">{{ block.settings.description }}</p>
                {%- endif -%}
                
                {%- if block.settings.features != blank -%}
                  <div class="service-features-{{ section.id }}">
                    {%- assign features = block.settings.features | split: ',' -%}
                    {%- for feature in features -%}
                      <div class="service-feature-{{ section.id }}">
                        <svg class="service-feature-icon-{{ section.id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span>{{ feature | strip }}</span>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                
                {%- if block.settings.button_text != blank -%}
                  <a href="{{ block.settings.button_link }}" class="btn-secondary service-button-{{ section.id }}">
                    {{ block.settings.button_text }}
                  </a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_cta and section.settings.cta_title != blank -%}
      <div class="services-cta-{{ section.id }}">
        <h3 class="services-cta-title-{{ section.id }}">{{ section.settings.cta_title }}</h3>
        {%- if section.settings.cta_description != blank -%}
          <p class="services-cta-description-{{ section.id }}">{{ section.settings.cta_description }}</p>
        {%- endif -%}
        {%- if section.settings.cta_button_text != blank -%}
          <a href="{{ section.settings.cta_button_link }}" class="btn-primary">
            {{ section.settings.cta_button_text }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
